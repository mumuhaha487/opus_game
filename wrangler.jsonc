{
  // GAME.INC.RE Worker. Build first (node build.mjs → dist/), then `npx wrangler deploy`.
  // Secrets AUTH_SECRET and PW_PEPPER are set on the Worker, never in this file.
  "name": "inc-games",
  "main": "worker.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "r2_buckets": [
    { "binding": "ACCOUNTS", "bucket_name": "game-inc-accounts", "preview_bucket_name": "game-inc-accounts-preview" }
  ],
  // PLATFORM §6.5 / 第2b轮：每Key每分钟读写各10次；namespace在账号内唯一。
  "ratelimits": [
    { "name": "API_RATE_READ", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_RATE_WRITE", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } },
    { "name": "TRADE_RATE", "namespace_id": "2003", "simple": { "limit": 40, "period": 60 } },
    { "name": "MARKET_RATE", "namespace_id": "2004", "simple": { "limit": 30, "period": 60 } },
    { "name": "MARKET_GLOBAL", "namespace_id": "2005", "simple": { "limit": 120, "period": 60 } }
  ],
  "routes": [
    { "pattern": "game.inc.re", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
